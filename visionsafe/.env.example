# VisionSafe Environment Configuration
# Copy to .env and fill in real values. NEVER commit .env

# --- Database (SQLite default; PostgreSQL also supported) ---
DATABASE_URL=sqlite+aiosqlite:///./visionsafe.db
DATABASE_URL_SYNC=sqlite:///./visionsafe.db

# --- Application ---
SECRET_KEY=change-me-to-a-random-256-bit-secret
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# --- ML / Vision ---
MODEL_PATH=models/yolov8n.pt
DEVICE=cuda
CONFIDENCE=0.35
IOU=0.5

# --- Paths ---
EVIDENCE_DIR=evidence
VIDEO_DIR=videos
MODELS_DIR=models

# --- CORS ---
FRONTEND_URL=http://localhost:5173

# --- Processing ---
FRAME_SKIP=1
MAX_CONCURRENT_JOBS=2
